	measure 'Report Subtitle' =
			VAR _y = SELECTEDVALUE('Calendar'[Year], "2015-2017")
			RETURN "Showing " & _y & "  |  " & FORMAT([Total Sales] / 1000000, "$#,0.00") & "M sales  |  " & FORMAT([Late %], "0.0%") & " late  |  " & FORMAT([Total Orders], "#,0") & " orders"
		displayFolder: Labels
		lineageTag: e18b0668-e37f-4d3c-8c7d-595f8c9274a5

	column Column
		dataType: string
		isHidden
		lineageTag: 90e34960-215a-43dd-b6fd-9a42e55f6241
