            "backColorSecondary": {
              "solid": {
                "color": "#162F57"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#EAF1FB"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0F3460"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#21406E"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#21406E"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#21406E"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#EAF1FB"
